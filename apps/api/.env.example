# Leave DATABASE_URL unset to use embedded PGlite (./.pglite) for local dev.
# DATABASE_URL=postgres://dpdpa:dpdpa@localhost:5432/dpdpa
PORT=3002
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=dpdpa-api
# Required in production (same generator as above). HMACs IP/User-Agent in the audit trail.
# AUDIT_HMAC_KEY=
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
