# Leave DATABASE_URL unset to use embedded PGlite (./.pglite) for local dev.
# DATABASE_URL=postgres://dpdpa:dpdpa@localhost:5432/dpdpa
PORT=3002
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=dpdpa-api
# Required in production (same generator as above). HMACs IP/User-Agent in the audit trail.
# AUDIT_HMAC_KEY=
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── File storage (exports, reports, evidence) ─────────────────────────────
# fs = local directory (dev / single node). memory = tests only (refused in production). S3 comes later.
STORAGE_DRIVER=fs
STORAGE_DIR=.storage

# ─── Background worker (pnpm --filter api worker) ──────────────────────────
# Idle poll interval in ms (100-60000) and jobs claimed per poll (1-50).
WORKER_POLL_MS=2000
WORKER_BATCH=5

# Encrypts website test-account logins for authenticated scans (phase 4c).
# 32 random bytes, base64: openssl rand -base64 32. Required in production; keep it out of git.
# CREDENTIAL_VAULT_KEY=

# Rate limits shared by every API instance (required in production): memory | postgres
# RATE_LIMIT_STORE=postgres
