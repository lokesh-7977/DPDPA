{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test src/test/*.test.ts",
    "create-super-admin": "tsx --env-file-if-exists=.env src/scripts/create-super-admin.ts",
    "seed:catalog": "tsx --env-file-if-exists=.env src/scripts/seed-catalog.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@node-rs/argon2": "2.2.2",
    "@scalar/hono-api-reference": "^0.12.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pino": "10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.9.1",
    "jiti": "2.7.0",
    "pino-pretty": "13.2.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "exports": {
    "./client": {
      "types": "./src/http/app.ts"
    }
  }
}
